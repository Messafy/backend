:80 {
	request_body {
		max_size 1MB
	}

	rate_limit {
		zone authentication {
			match {
				path /v1/auth/*
			}
			key {http.request.header.CF-Connecting-IP}
			events 10
			window 1m
		}

		zone application {
			key {http.request.header.CF-Connecting-IP}
			events 300
			window 1m
		}
	}

	reverse_proxy {$BACKEND_UPSTREAM:backend:8080}
}
